# ACE - Agent Compliance Engine Environment Configuration
# Copy this file to .env and customize values for your deployment.
# NEVER commit the actual .env file or credentials to version control.

# Application Configuration
APP_NAME=ACE-AgentComplianceEngine
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# Database Configuration (MySQL 8.x)
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=mysql+pymysql://ace_user:ace_password@localhost:3306/ace_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# Redis Configuration (Celery Broker & Result Backend)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# MyBlocks RAG Configuration (Phase 3)
MYBLOCKS_RAG_BASE_URL=https://myblocks.in/myblock_private
MYBLOCKS_RAG_API_KEY=
MYBLOCKS_RAG_TIMEOUT=10.0
MYBLOCKS_RAG_MCP_URL=
MYBLOCKS_RAG_MCP_AUTH_TOKEN=
MYBLOCKS_RAG_MCP_TIMEOUT=10.0

# MyBlocks QA Configuration (Phase 4)
MYBLOCKS_QA_BASE_URL=https://myblocks.in/qa_app
MYBLOCKS_QA_API_KEY=
MYBLOCKS_QA_TIMEOUT=10.0
MYBLOCKS_QA_MCP_URL=
MYBLOCKS_QA_MCP_AUTH_TOKEN=
MYBLOCKS_QA_MCP_TIMEOUT=10.0

# 9-Rule Agent Evaluation Configuration (Phase 5)
RULE_ENGINE_BASE_URL=
RULE_ENGINE_API_KEY=
RULE_ENGINE_TIMEOUT=10.0
RULE_ENGINE_MCP_URL=
RULE_ENGINE_MCP_AUTH_TOKEN=
RULE_ENGINE_MCP_TIMEOUT=15.0

# ACE MCP Server Configuration
MCP_SERVER_ENABLED=true
MCP_AUTH_TOKEN=

